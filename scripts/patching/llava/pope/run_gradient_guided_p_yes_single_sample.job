#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=pope_llava_gg_p_yes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --output=slurm_outputs/patching/llava/pope/run_gradient_guided_p_yes_single_%j.out

# Single-sample LLaVA gradient-guided token patching (maximize_p_yes).
# Settings mirror run_gradient_guided_objectives_10_samples.job exactly; the
# only adaptation is running one SAMPLE_ID per job so samples run concurrently.
# Submit with: sbatch --export=SAMPLE_ID=<id> <this script>

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments

export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"
export VLM_UQ_USER_STORAGE_ROOT="${VLM_UQ_USER_STORAGE_ROOT:-$VLM_UQ_STORAGE_ROOT/$USER}"
export HF_HOME="${HF_HOME:-$VLM_UQ_USER_STORAGE_ROOT/hf_home}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_datasets}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_transformers}"
export VLM_UQ_PREP_CACHE="${VLM_UQ_PREP_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/vlm_uq_prepared_cache}"

mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$TRANSFORMERS_CACHE" "$VLM_UQ_PREP_CACHE"
mkdir -p slurm_outputs/patching/llava/pope

SAMPLE_ID="${SAMPLE_ID:?Set SAMPLE_ID, e.g. sbatch --export=SAMPLE_ID=1291 run_gradient_guided_p_yes_single_sample.job}"

VLM_ID="${VLM_ID:-llava-hf/llava-1.5-7b-hf}"
VLM_SHORT="${VLM_ID//\//_}"
VLM_SHORT="${VLM_SHORT//./-}"
DATASET="${DATASET:-pope}"
DATASET_SPLIT="${DATASET_SPLIT:-random}"
DEVICE="${DEVICE:-cuda}"
SEVERITY="${SEVERITY:-extreme}"
LAYERS="${LAYERS:-$(seq -s ' ' 1 32)}"
MAX_PATCHES="${MAX_PATCHES:-10}"
VISUAL_TOP_K="${VISUAL_TOP_K:-64}"

PATCHING_DATASET="${PATCHING_DATASET:-$VLM_UQ_STORAGE_ROOT/patching/$VLM_SHORT/$DATASET/$DATASET_SPLIT/patching_dataset_$DATASET.json}"
OUTPUT_DIR="${OUTPUT_DIR:-$VLM_UQ_STORAGE_ROOT/patching/gradient_guided_token_patching/$VLM_SHORT/$DATASET/$DATASET_SPLIT/sample_$SAMPLE_ID}"

echo "sample=$SAMPLE_ID objective=maximize_p_yes layers=$LAYERS"
srun python -u -m src.cli.run_gradient_guided_token_patching \
  --patching_dataset "$PATCHING_DATASET" \
  --vlm "$VLM_ID" \
  --output_dir "$OUTPUT_DIR" \
  --sample_id "$SAMPLE_ID" \
  --severity "$SEVERITY" \
  --layers $LAYERS \
  --max_patches "$MAX_PATCHES" \
  --visual_top_k "$VISUAL_TOP_K" \
  --objectives maximize_p_yes \
  --early_stop_window 3 \
  --early_stop_abs_sum_threshold 0.002 \
  --require_corrupted_no \
  --device "$DEVICE"
