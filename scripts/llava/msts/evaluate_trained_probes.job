#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=llava_eval_msts_probes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=01:00:00
#SBATCH --output=slurm_outputs/llava/msts/evaluate_trained_probes_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments

export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"
export VLM_UQ_USER_STORAGE_ROOT="${VLM_UQ_USER_STORAGE_ROOT:-$VLM_UQ_STORAGE_ROOT/$USER}"

export HF_HOME="${HF_HOME:-$VLM_UQ_USER_STORAGE_ROOT/hf_home}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_datasets}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_transformers}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp/matplotlib-cache}"

mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$TRANSFORMERS_CACHE"
mkdir -p "$MPLCONFIGDIR"
mkdir -p slurm_outputs/llava/msts

MSTS_RUN_DIR="${MSTS_RUN_DIR:-/projects/prjs2014/msts/llava-hf/llava-1.5-7b-hf/run_14423ff29d}"
OUTPUT_ROOT="${OUTPUT_ROOT:-/projects/prjs2014/tgroot/probe_results/msts_eval/llava}"
BATCH_SIZE="${BATCH_SIZE:-64}"
DEVICE="${DEVICE:-cpu}"
MODEL_TYPES="${MODEL_TYPES:-linear mlp}"

# shellcheck disable=SC2206
MODEL_TYPE_ARRAY=($MODEL_TYPES)

srun python -u -m src.cli.evaluate_msts_probes \
  --msts_run_dir "$MSTS_RUN_DIR" \
  --output_root "$OUTPUT_ROOT" \
  --batch_size "$BATCH_SIZE" \
  --device "$DEVICE" \
  --model_types "${MODEL_TYPE_ARRAY[@]}"
