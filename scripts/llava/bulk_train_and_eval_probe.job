#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=mlp_pope_probes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=04:00:00
#SBATCH --output=slurm_outputs/mlp_pope_probes_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

# Navigate to the project directory
cd $HOME/vlm_uncertainty/ || exit 1

source activate llava-experiments

# HF caches on project storage
export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"
export VLM_UQ_USER_STORAGE_ROOT="${VLM_UQ_USER_STORAGE_ROOT:-$VLM_UQ_STORAGE_ROOT/$USER}"

export HF_HOME="${HF_HOME:-$VLM_UQ_USER_STORAGE_ROOT/hf_home}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_datasets}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_transformers}"

mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$TRANSFORMERS_CACHE"

# ------------------------------------------------------------------
# Experiment config
# ------------------------------------------------------------------
# DATA_PATH="$VLM_UQ_STORAGE_ROOT/imagenet_r_16mc/imagenet-r/llava-hf/llava-1.5-7b-hf/run_035f83a53c/supervision_dataset.pt"
# DATA_PATH="$VLM_UQ_STORAGE_ROOT/vqa-v2/llava-hf/llava-1.5-7b-hf/run_7f57ad86ba/supervision_dataset.pt"
DATA_PATH="$VLM_UQ_STORAGE_ROOT/pope/llava-hf/llava-1.5-7b-hf/run_4971752193/supervision_dataset.pt"
MODEL_TYPE="mlp"  
NUM_EPOCHS=20
BATCH_SIZE=32
OUTPUT_DIR="probe_results/pope/random"
# OUTPUT_DIR="probe_results/imagenet-r/16mc-clip"


# List of SINGLE features to test (one per run)
FEATURE_LIST=(
  vision_mean_layer_12
  vision_mean_layer_-1

  lm_visual_mean_layer_16
  lm_visual_mean_layer_-1

  lm_question_mean_layer_16
  lm_question_mean_layer_-1

  lm_visual_lasttok_layer_16
  lm_visual_lasttok_layer_-1

  lm_question_lasttok_layer_16
  lm_question_lasttok_layer_-1

  lm_answer_mean_layer_16
  lm_answer_mean_layer_-1

  lm_answer_lasttok_layer_16
  lm_answer_lasttok_layer_-1

  lm_fullspan_mean_layer_16
  lm_fullspan_mean_layer_-1
  lm_fullspan_lasttok_layer_16
  lm_fullspan_lasttok_layer_-1

  lm_question_including_mean_layer_16
  lm_question_including_mean_layer_-1
  lm_question_including_lasttok_layer_16
  lm_question_including_lasttok_layer_-1

  answer_gen_negp_max
  answer_gen_negp_min
  answer_gen_negp_mean
  answer_gen_negp_std
  answer_gen_neglogp_mean
  answer_gen_neglogp_std
  answer_gen_entropy_max
  answer_gen_entropy_min
  answer_gen_entropy_mean
  answer_gen_entropy_std
)

# ------------------------------------------------------------------
# Run loop
# ------------------------------------------------------------------

for FEATURE in "${FEATURE_LIST[@]}"; do
  echo "============================================================"
  echo "Running probe for feature: ${FEATURE}"
  echo "============================================================"

  srun python -m src.cli.train \
    --data_path "$DATA_PATH" \
    --features "$FEATURE" \
    --model_type "$MODEL_TYPE" \
    --num_epochs "$NUM_EPOCHS" \
    --batch_size "$BATCH_SIZE" \
    --output_dir "$OUTPUT_DIR" \
    --no_class_weights \

done
