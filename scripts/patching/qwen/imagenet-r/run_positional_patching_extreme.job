#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=imagenet_r_qwen_positional_extreme
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=16:00:00
#SBATCH --output=slurm_outputs/patching/qwen/imagenet-r/run_positional_patching_extreme_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments

export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"
export VLM_UQ_USER_STORAGE_ROOT="${VLM_UQ_USER_STORAGE_ROOT:-$VLM_UQ_STORAGE_ROOT/$USER}"

export HF_HOME="${HF_HOME:-$VLM_UQ_USER_STORAGE_ROOT/hf_home}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_datasets}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_transformers}"

mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$TRANSFORMERS_CACHE"
export VLM_UQ_PREP_CACHE="${VLM_UQ_PREP_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/vlm_uq_prepared_cache}"
mkdir -p "$VLM_UQ_PREP_CACHE"
mkdir -p slurm_outputs/patching/qwen/imagenet-r

VLM_ID="${VLM_ID:-Qwen/Qwen3.5-9B}"
VLM_SHORT="${VLM_ID//\//_}"
VLM_SHORT="${VLM_SHORT//./-}"
DATASET=imagenet-r
DEVICE="${DEVICE:-cuda}"
SEVERITY="${SEVERITY:-extreme}"
LAYER="${LAYER:-17}"
MAX_SAMPLES="${MAX_SAMPLES:-1000}"
CHECKPOINT_EVERY="${CHECKPOINT_EVERY:-10}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-15}"
SAMPLE_VISUAL_EVERY="${SAMPLE_VISUAL_EVERY:-10}"
INCLUDE_VISUAL_LAST="${INCLUDE_VISUAL_LAST:-10}"
QWEN_PREFILL_EMPTY_THINKING="${QWEN_PREFILL_EMPTY_THINKING:-1}"
OUTPUT_TAG="${OUTPUT_TAG:-extreme_answer_confidence_finaltoken}"
SAVE_CLEAN_ANSWER_PROBABILITY="${SAVE_CLEAN_ANSWER_PROBABILITY:-0}"
SAVE_STRIPPED_ANSWER_SOFTMAX="${SAVE_STRIPPED_ANSWER_SOFTMAX:-0}"
STRIPPED_ANSWER_SOFTMAX_DTYPE="${STRIPPED_ANSWER_SOFTMAX_DTYPE:-float32}"
RETAIN_CHECKPOINT="${RETAIN_CHECKPOINT:-0}"

PATCHING_DATASET="${PATCHING_DATASET:-$VLM_UQ_STORAGE_ROOT/patching/$VLM_SHORT/$DATASET/patching_dataset_$DATASET.json}"
OUTPUT_DIR="${OUTPUT_DIR:-$VLM_UQ_STORAGE_ROOT/patching/positional_patching_results_including_visual/$VLM_SHORT/$DATASET/$OUTPUT_TAG}"

EXTRA_ARGS=()
if [[ "$QWEN_PREFILL_EMPTY_THINKING" == "1" ]]; then
  EXTRA_ARGS+=(--qwen_prefill_empty_thinking)
  OUTPUT_DIR="${OUTPUT_DIR%/}_qwen_prefill_empty_thinking"
fi
if [[ "$SAVE_CLEAN_ANSWER_PROBABILITY" == "1" ]]; then
  EXTRA_ARGS+=(--save_clean_answer_probability)
fi
if [[ "$SAVE_STRIPPED_ANSWER_SOFTMAX" == "1" ]]; then
  EXTRA_ARGS+=(--save_stripped_answer_softmax --stripped_answer_softmax_dtype "$STRIPPED_ANSWER_SOFTMAX_DTYPE")
fi
if [[ "$RETAIN_CHECKPOINT" == "1" ]]; then
  EXTRA_ARGS+=(--retain_checkpoint)
fi

srun python -u -m src.cli.run_positional_patching \
  --patching_dataset "$PATCHING_DATASET" \
  --vlm "$VLM_ID" \
  --output_dir "$OUTPUT_DIR" \
  --layer "$LAYER" \
  --severity "$SEVERITY" \
  --sample_visual_every "$SAMPLE_VISUAL_EVERY" \
  --include_visual_last "$INCLUDE_VISUAL_LAST" \
  --device "$DEVICE" \
  --max_samples "$MAX_SAMPLES" \
  --max_new_tokens "$MAX_NEW_TOKENS" \
  --checkpoint_every "$CHECKPOINT_EVERY" \
  "${EXTRA_ARGS[@]}"
