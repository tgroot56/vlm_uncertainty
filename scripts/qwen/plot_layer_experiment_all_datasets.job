#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=qwen_layer_plot
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:30:00
#SBATCH --mem=16G
#SBATCH --output=slurm_outputs/qwen/qwen_layer_plot_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments

mkdir -p slurm_outputs/qwen probe_results/layer_experiment

RUN_SUFFIX="${RUN_SUFFIX:-_1k}"
OUTPUT_PDF="${OUTPUT_PDF:-probe_results/layer_experiment/qwen_all_datasets_mlp_layer_brier${RUN_SUFFIX}.pdf}"

python -m utils.tables_and_plots.plot_layer_experiment_brier \
  --model qwen \
  --combined-all-datasets \
  --layer-run-suffix "$RUN_SUFFIX" \
  --combined-output-pdf "$OUTPUT_PDF"
