#!/bin/bash

# Sanity-check that the Qwen patching pipeline now produces a non-zero
# baseline after the max_new_tokens / thinking-prefix fix. Uses 30
# calibration samples and sigma_max=6 so it finishes well under 50 minutes.

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=qwen_patch_calibrate_check
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=0:45:00
#SBATCH --output=slurm_outputs/patching/qwen/coco-qa-vi/quick_calibrate_check_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments

export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"
export VLM_UQ_USER_STORAGE_ROOT="${VLM_UQ_USER_STORAGE_ROOT:-$VLM_UQ_STORAGE_ROOT/$USER}"

export HF_HOME="${HF_HOME:-$VLM_UQ_USER_STORAGE_ROOT/hf_home}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_datasets}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_transformers}"

mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$TRANSFORMERS_CACHE"
export VLM_UQ_PREP_CACHE="${VLM_UQ_PREP_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/vlm_uq_prepared_cache}"
mkdir -p "$VLM_UQ_PREP_CACHE"
mkdir -p slurm_outputs/patching/qwen/coco-qa-vi

VLM_ID="${VLM_ID:-Qwen/Qwen3.5-9B}"
DATASET=coco-qa-vi
CALIBRATION_SAMPLES="${CALIBRATION_SAMPLES:-30}"
SIGMA_MAX="${SIGMA_MAX:-6}"
SEED="${SEED:-42}"
DEVICE="${DEVICE:-cuda}"

srun python -u -m src.cli.build_patching_dataset \
  --vlm "$VLM_ID" \
  --dataset "$DATASET" \
  --calibration_only \
  --calibration_samples "$CALIBRATION_SAMPLES" \
  --sigma_max "$SIGMA_MAX" \
  --seed "$SEED" \
  --device "$DEVICE"
