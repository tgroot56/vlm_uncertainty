#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=llava_positional_clean_answer_plot
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=01:00:00
#SBATCH --output=slurm_outputs/patching/llava/plot_clean_answer_positional_all_datasets_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"

srun python -u scripts/patching/llava/plot_clean_answer_positional_all_datasets.py
