#!/bin/bash

#SBATCH --partition=rome
#SBATCH --job-name=qwen_coco_clean_answer_layer_plot
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=01:00:00
#SBATCH --output=slurm_outputs/patching/qwen/coco-qa-vi/plot_clean_answer_layer_sweep_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"

srun python -u scripts/patching/qwen/plot_coco_clean_answer_layer_sweep.py
