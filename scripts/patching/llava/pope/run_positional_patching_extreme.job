#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=pope_llava_positional_patch_extreme
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --output=slurm_outputs/patching/llava/pope/run_positional_patching_extreme_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments

export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"
export VLM_UQ_USER_STORAGE_ROOT="${VLM_UQ_USER_STORAGE_ROOT:-$VLM_UQ_STORAGE_ROOT/$USER}"

export HF_HOME="${HF_HOME:-$VLM_UQ_USER_STORAGE_ROOT/hf_home}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_datasets}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_transformers}"

mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$TRANSFORMERS_CACHE"

export VLM_UQ_PREP_CACHE="${VLM_UQ_PREP_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/vlm_uq_prepared_cache}"
mkdir -p "$VLM_UQ_PREP_CACHE"
mkdir -p slurm_outputs/patching/llava/pope

VLM_ID="${VLM_ID:-llava-hf/llava-1.5-7b-hf}"
VLM_SHORT="${VLM_ID//\//_}"
VLM_SHORT="${VLM_SHORT//./-}"
DATASET="${DATASET:-pope}"
DATASET_SPLIT="${DATASET_SPLIT:-random}"
DEVICE="${DEVICE:-cuda}"
LAYER="${LAYER:-17}"
SEVERITY="${SEVERITY:-extreme}"
MAX_SAMPLES="${MAX_SAMPLES:-1000}"
SAMPLE_VISUAL_EVERY="${SAMPLE_VISUAL_EVERY:-10}"
INCLUDE_VISUAL_LAST="${INCLUDE_VISUAL_LAST:-10}"
OUTPUT_TAG="${OUTPUT_TAG:-extreme_answer_confidence}"

PATCHING_DATASET="${PATCHING_DATASET:-$VLM_UQ_STORAGE_ROOT/patching/$VLM_SHORT/$DATASET/$DATASET_SPLIT/patching_dataset_$DATASET.json}"
OUTPUT_DIR="${OUTPUT_DIR:-$VLM_UQ_STORAGE_ROOT/patching/positional_patching_results_including_visual/$VLM_SHORT/$DATASET/$DATASET_SPLIT/$OUTPUT_TAG}"

srun python -u -m src.cli.run_positional_patching \
  --patching_dataset "$PATCHING_DATASET" \
  --vlm "$VLM_ID" \
  --output_dir "$OUTPUT_DIR" \
  --layer "$LAYER" \
  --severity "$SEVERITY" \
  --sample_visual_every "$SAMPLE_VISUAL_EVERY" \
  --include_visual_last "$INCLUDE_VISUAL_LAST" \
  --device "$DEVICE" \
  --max_samples "$MAX_SAMPLES"
