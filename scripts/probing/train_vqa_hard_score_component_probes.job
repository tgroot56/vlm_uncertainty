#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=vqa_hard_component_probes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --mem=180G
#SBATCH --time=08:00:00
#SBATCH --output=slurm_outputs/probing/vqa_hard_component_probes_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments

mkdir -p slurm_outputs/probing

MODEL="${MODEL:-llava}"
SHUFFLE_TRAIN_LABELS="${SHUFFLE_TRAIN_LABELS:-0}"
MODEL_TYPE="${MODEL_TYPE:-mlp}"
NUM_EPOCHS="${NUM_EPOCHS:-20}"
BATCH_SIZE="${BATCH_SIZE:-32}"
SEED="${SEED:-42}"

case "$MODEL" in
  llava)
    DATA_PATH="${DATA_PATH:-/projects/prjs2014/supervised_datasets/vqa-v2/llava-hf/llava-1.5-7b-hf/run_7f57ad86ba/supervision_dataset.pt}"
    VISION_DATA_PATH="${VISION_DATA_PATH:-$DATA_PATH}"
    OUTPUT_ROOT="${OUTPUT_ROOT:-probe_results/llava/vqa-v2-hard-exact}"
    FEATURE_LIST=(
      vision_mean_layer_12
      lm_visual_mean_layer_16
      lm_question_lasttok_layer_16
      lm_fullspan_lasttok_layer_16
      answer_gen_entropy_mean
      answer_gen_neglogp_mean
    )
    ;;
  qwen)
    DATA_PATH="${DATA_PATH:-/projects/prjs2014/qwen/vqa-v2/Qwen/Qwen3.5-9B/run_856576cb2c/supervision_dataset.pt}"
    VISION_DATA_PATH="${VISION_DATA_PATH:-/projects/prjs2014/qwen/vqa-v2/Qwen/Qwen3.5-9B/run_6d66dbfe2b/supervision_dataset_visual.pt}"
    OUTPUT_ROOT="${OUTPUT_ROOT:-probe_results/qwen/vqa-v2-hard-exact}"
    FEATURE_LIST=(
      vision_mean_layer_13
      lm_visual_mean_layer_15
      lm_question_lasttok_layer_16
      lm_fullspan_lasttok_layer_16
      answer_gen_entropy_mean
      answer_gen_neglogp_mean
    )
    ;;
  *)
    echo "Unknown MODEL=$MODEL; expected llava or qwen" >&2
    exit 1
    ;;
esac

if [[ "$SHUFFLE_TRAIN_LABELS" == "1" ]]; then
  OUTPUT_DIR="$OUTPUT_ROOT/shuffle_train_labels"
  SHUFFLE_ARGS=(--shuffle_train_labels)
else
  OUTPUT_DIR="$OUTPUT_ROOT"
  SHUFFLE_ARGS=()
fi

mkdir -p "$OUTPUT_DIR"

echo "MODEL=$MODEL"
echo "DATA_PATH=$DATA_PATH"
echo "VISION_DATA_PATH=$VISION_DATA_PATH"
echo "OUTPUT_DIR=$OUTPUT_DIR"
echo "SHUFFLE_TRAIN_LABELS=$SHUFFLE_TRAIN_LABELS"

for FEATURE in "${FEATURE_LIST[@]}"; do
  FEATURE_DATA_PATH="$DATA_PATH"
  if [[ "$FEATURE" == vision_* ]]; then
    FEATURE_DATA_PATH="$VISION_DATA_PATH"
  fi

  echo "============================================================"
  echo "Running hard-label VQA-v2 probe for feature: ${FEATURE}"
  echo "Feature data path: ${FEATURE_DATA_PATH}"
  echo "============================================================"

  srun python -m src.cli.train \
    --data_path "$FEATURE_DATA_PATH" \
    --features "$FEATURE" \
    --model_type "$MODEL_TYPE" \
    --num_epochs "$NUM_EPOCHS" \
    --batch_size "$BATCH_SIZE" \
    --output_dir "$OUTPUT_DIR" \
    --seed "$SEED" \
    --no_class_weights \
    --binarize_one_score_labels \
    "${SHUFFLE_ARGS[@]}"
done
