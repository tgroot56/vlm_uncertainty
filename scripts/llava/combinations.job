#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=train_eval_probe
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=04:00:00
#SBATCH --output=slurm_outputs/train_eval_probe_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/vlm_uncertainty/
source activate llava-experiments

# ----------------------------
export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"
export VLM_UQ_USER_STORAGE_ROOT="${VLM_UQ_USER_STORAGE_ROOT:-$VLM_UQ_STORAGE_ROOT/$USER}"

# HF cache on project storage
# ----------------------------
export HF_HOME="${HF_HOME:-$VLM_UQ_USER_STORAGE_ROOT/hf_home}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_datasets}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_transformers}"

mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$TRANSFORMERS_CACHE"

# ----------------------------
# Experiment config
# ----------------------------

DATA_PATH="$VLM_UQ_STORAGE_ROOT/vqa-v2/llava-hf/llava-1.5-7b-hf/run_cc1adbca16/supervision_dataset.pt"

# Define feature list here
FEATURES=(answer_gen_negp_max lm_answer_mean_layer_16 lm_prompt_lasttok_middle)

MODEL_TYPE="mlp"
OUTPUT_DIR="probe_results/vqa-v2/combinations"
HIDDEN_DIMS="256 128"
NUM_EPOCHS=20
BATCH_SIZE=32

# ----------------------------
# Function: generate combinations
# ----------------------------

generate_combinations() {
    local arr=("$@")
    local n=${#arr[@]}
    local max=$((1 << n))

    for ((mask=0; mask<max; mask++)); do
        combo=()
        count=0

        for ((i=0; i<n; i++)); do
            if ((mask & (1 << i))); then
                combo+=("${arr[i]}")
                ((count++))
            fi
        done

        # Only combinations with size >= 2
        if ((count >= 2)); then
            echo "${combo[@]}"
        fi
    done
}

# ----------------------------
# Run all combinations
# ----------------------------

echo "Running feature combinations..."

for FEATURE_SET in $(generate_combinations "${FEATURES[@]}"); do

    # Convert to space-separated string
    FEATURES_STR="$FEATURE_SET"

    # Create readable name for output directory
    SAFE_NAME=$(echo "$FEATURES_STR" | tr ' ' '__')
    RUN_OUTPUT_DIR="${OUTPUT_DIR}/features_${SAFE_NAME}"

    echo "--------------------------------------------"
    echo "Training with features: $FEATURES_STR"
    echo "Output dir: $RUN_OUTPUT_DIR"
    echo "--------------------------------------------"

    srun python -u -m src.cli.train \
      --data_path $DATA_PATH \
      --features $FEATURES_STR \
      --model_type $MODEL_TYPE \
      --hidden_dims $HIDDEN_DIMS \
      --num_epochs $NUM_EPOCHS \
      --batch_size $BATCH_SIZE \
      --output_dir $RUN_OUTPUT_DIR \
      --no_class_weights

done

echo "All combinations completed."
