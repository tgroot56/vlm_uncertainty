#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=qwen_imagenet_r_layers
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --mem=128G
#SBATCH --output=slurm_outputs/qwen/imagenet_r_layer_experiment_%A.out

export DATASET_ID="${DATASET_ID:-imagenet-r}"
export DATASET_LABEL="${DATASET_LABEL:-ImageNet-R}"
export OUTPUT_STEM="${OUTPUT_STEM:-qwen_imagenet_r_mlp_layer_brier}"

exec bash "$HOME/vlm_uncertainty/scripts/qwen/coco-qa-vi/layer_experiment.job"
