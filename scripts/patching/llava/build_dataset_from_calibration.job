#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=llava_patch_build_precal
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=24:00:00
#SBATCH --output=slurm_outputs/patching/llava/build_precal_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/vlm_uncertainty/" || exit 1

source activate llava-experiments

export VLM_UQ_STORAGE_ROOT="${VLM_UQ_STORAGE_ROOT:-/projects/prjs2014}"
export VLM_UQ_USER_STORAGE_ROOT="${VLM_UQ_USER_STORAGE_ROOT:-$VLM_UQ_STORAGE_ROOT/$USER}"

export HF_HOME="${HF_HOME:-$VLM_UQ_USER_STORAGE_ROOT/hf_home}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_datasets}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/hf_transformers}"

mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$TRANSFORMERS_CACHE"

export VLM_UQ_PREP_CACHE="${VLM_UQ_PREP_CACHE:-$VLM_UQ_USER_STORAGE_ROOT/vlm_uq_prepared_cache}"
mkdir -p "$VLM_UQ_PREP_CACHE"
mkdir -p slurm_outputs/patching/llava

VLM_ID="${VLM_ID:-llava-hf/llava-1.5-7b-hf}"
DATASET="${DATASET:-vqa-v2}"
DATASET_SPLIT="${DATASET_SPLIT:-}"
MAX_SAMPLES="${MAX_SAMPLES:-2000}"
SEED="${SEED:-42}"
DEVICE="${DEVICE:-cuda}"
OUTPUT_DIR="${OUTPUT_DIR:-}"

if [[ "$DATASET" == "pope" && -z "$DATASET_SPLIT" ]]; then
  DATASET_SPLIT="random"
fi

# CALIBRATION_PATH must point to a previously saved calibration.json.
# Example: /projects/prjs2014/patching/llava-hf_llava-1-5-7b-hf/vqa-v2/calibration.json
CALIBRATION_PATH="${CALIBRATION_PATH:-/projects/prjs2014/patching/llava-hf_llava-1-5-7b-hf/vqa-v2/calibration.json}"

EXTRA_ARGS=()
if [[ -n "$DATASET_SPLIT" ]]; then
  EXTRA_ARGS+=(--dataset_split "$DATASET_SPLIT")
fi
if [[ -n "$OUTPUT_DIR" ]]; then
  EXTRA_ARGS+=(--output_dir "$OUTPUT_DIR")
fi

# Build using pre-existing calibration — all samples go to the build phase.
srun python -u -m src.cli.build_patching_dataset \
  --vlm "$VLM_ID" \
  --dataset "$DATASET" \
  "${EXTRA_ARGS[@]}" \
  --max_samples "$MAX_SAMPLES" \
  --load_calibration "$CALIBRATION_PATH" \
  --seed "$SEED" \
  --device "$DEVICE"
